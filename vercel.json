{
  "rewrites": [
    {
      "source": "/realtime",
      "destination": "http://de4.bot-hosting.cloud:27208/realtime/"
    },
    {
      "source": "/realtime/(.*)",
      "destination": "http://de4.bot-hosting.cloud:27208/realtime/$1"
    },
    {
      "source": "/health",
      "destination": "http://de4.bot-hosting.cloud:27208/health"
    },
    {
      "source": "/api/:path*",
      "destination": "http://de4.bot-hosting.cloud:27208/api/:path*"
    }
  ]
}
