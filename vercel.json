{
  "rewrites": [
    {
      "source": "/realtime",
      "destination": "https://enumareality.apps.bot-hosting.cloud/health/realtime/"
    },
    {
      "source": "/realtime/(.*)",
      "destination": "https://enumareality.apps.bot-hosting.cloud/health/realtime/$1"
    },
    {
      "source": "/health",
      "destination": "https://enumareality.apps.bot-hosting.cloud/health/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://enumareality.apps.bot-hosting.cloud/health/api/:path*"
    }
  ]
}
